# Copy to ".env" and fill in ONE provider key. Never commit ".env".
# Hosted options (set exactly one key):
ANTHROPIC_API_KEY=your-anthropic-key-here
# GEMINI_API_KEY=your-gemini-key-here
# GROQ_API_KEY=your-groq-key-here
# MISTRAL_API_KEY=your-mistral-key-here
# OPENROUTER_API_KEY=your-openrouter-key-here

# Local model (Ollama) instead:
# AUDITOR_PROVIDER=openai_compatible
# AUDITOR_BASE_URL=http://localhost:11434/v1
# AUDITOR_API_KEY=ollama
# AUDITOR_MODEL=qwen2.5:7b

# Optional overrides:
# AUDITOR_PROVIDER=anthropic
# AUDITOR_MODEL=claude-sonnet-5-5
# AUDITOR_LLM_TIMEOUT_S=90
# AUDITOR_WALL_CLOCK_S=600