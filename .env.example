# Copy this file to ".env" and fill in ONE provider's key. Never commit ".env".
# Free option: create a Gemini key at https://aistudio.google.com/apikey (no credit card).
GEMINI_API_KEY=your-gemini-key-here

# Other supported providers (use only one):
# GROQ_API_KEY=your-groq-key-here
# OPENROUTER_API_KEY=your-openrouter-key-here
# ANTHROPIC_API_KEY=your-anthropic-key-here

# Optional overrides. If AUDITOR_PROVIDER is unset, it is detected from whichever key is set.
# AUDITOR_PROVIDER=gemini
# AUDITOR_MODEL=gemini-3.5-flash-lite
# AUDITOR_MIN_INTERVAL_S=5